<% content_for :title, "Projects" %>
<div class="container mt-5">
  <% if notice.present? %>
    <div class="alert alert-success">
      <%= notice %>
    </div>
  <% end %>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h2>Projects</h2>
      <%= link_to "New Project", new_project_path, class: "btn btn-primary" %>
    </div>
    <div class="card-body">
      <% if @projects.any? %>
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Title</th>
              <th>description</th>
              <th>Status</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @projects.each do |project| %>
              <tr>
                <td><%= project.title %></td>
                <td><%= truncate(project.description, length: 50) %></td>
                <td><%= project.status %></td>
                <td class="text-center">
                  <%= link_to "Show", project, class: "btn btn-sm btn-primary" %>
                  <%= link_to "Edit", edit_project_path(project), class: "btn btn-sm btn-success" %>
                  <%= link_to "Delete", project, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-center">No Projects found.</p>
      <% end %>
    </div>
  </div>
</div>
