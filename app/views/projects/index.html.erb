<% content_for :title, "Projects" %>
<div class="justify-content-center">
  <% if notice.present? %>
  <div class="alert alert-success">
    <%= notice %>
  </div>
  <% end %>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h2>Projects</h2>
      <%= link_to "New Project", new_project_path, class: "btn btn-sm btn-primary" %>
    </div>
    <div class="card-body">
      <% if @projects.any? %>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Title</th>
            <th>description</th>
            <th>Status</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @projects.each do |project| %>
          <tr>
            <td><%= project.title %></td>
            <td><%= truncate(project.description, length: 50) %></td>
            <td class="text-success"><%= project.status %></td>
            <td class="text-center">
              <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
                <%= link_to "Show", project, class: "text-primary text-decoration-none" %> |
                <%= link_to "Edit", edit_project_path(project), class: "text-success text-decoration-none" %> |
                <%= link_to "Delete", project_path(project), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-danger text-decoration-none" %>
              </div>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
      <% else %>
      <p class="text-center">No Projects found.</p>
      <% end %>
    </div>
  </div>
</div>
